# Connection string for the Postgres + pgvector database.
DATABASE_URL=postgres://opendhu:opendhu@127.0.0.1:55432/opendhu

# HTTP bind address and on-disk storage for uploaded PDFs.
READER_BIND=0.0.0.0:8790
READER_DATA_DIR=./data

# HMAC secret for issued dev-login tokens. Change in production.
READER_JWT_SECRET=change-me

# CORS origin override (comma-free single origin). Leave empty for permissive dev CORS.
# READER_CORS_ORIGIN=http://127.0.0.1:5181

# Optional OpenAI-compatible AI provider.
# Without LLM_API_KEY the reading room still works (reading, annotations,
# progress, keyword retrieval); assist/ask/compare return 503.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
