{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@opendhu/literature-center": ["../../packages/literature-center/src/index.ts"],
      "@opendhu/literature-reader": ["../../packages/literature-reader/src/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "../../packages/literature-center/src"]
}
